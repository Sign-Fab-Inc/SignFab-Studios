{
  "routes": [
    {"route": "/.auth/login/github", "statusCode": 404},
    {"route": "/.auth/*", "allowedRoles": ["anonymous"]},
    {"route": "/access-denied.html", "allowedRoles": ["anonymous"]},
    {"route": "/*", "allowedRoles": ["employee"]}
  ],
  "responseOverrides": {
    "401": {"redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer", "statusCode": 302},
    "403": {"rewrite": "/access-denied.html"}
  },
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/REPLACE_WITH_SIGNFAB_TENANT_ID/v2.0",
          "clientIdSettingName": "SIGNFAB_ENTRA_CLIENT_ID",
          "clientSecretSettingName": "SIGNFAB_ENTRA_CLIENT_SECRET"
        }
      }
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
